# Copiar este archivo como .env y reemplazar los valores locales.
# Nunca colocar secretos reales en este archivo de ejemplo.
DJANGO_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_LOCAL
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_SSL_REDIRECT=false

